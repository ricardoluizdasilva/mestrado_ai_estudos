# TP6 exercício 7: odometria embarcada em Aseba (protótipo A TESTAR em hardware).
# Convenções: x/y e ds em unidades de 0.1 mm; theta em unidades Aseba (-pi,pi -> int16).
# Intervalo fixo de timer0 = 100 ms. Usar GANHO APENAS DEPOIS de calibrar.
# KD_MILLI: round(Kd(cm/(s*unidade motor.speed))*1000) calculado no script Python.
# Exemplo: Kd=0.04 -> KD_MILLI=40, mas é apenas ilustrativo, NÃO é calibração.
# Risco de arredondamento (Aseba aritmética inteira), escorregamento e overflow int16.
# Este programa não comanda motores. Apenas calcula pose estimada.

var odo_x_01mm = 0
var odo_y_01mm = 0
var odo_theta_b = 0
var odo_kd_milli = 35
var odo_dl_01mm = 0
var odo_dr_01mm = 0
var odo_ds_01mm = 0
var odo_diff_01mm = 0
var odo_dtheta_b = 0
var odo_theta_mid_b = 0
var odo_cos_b = 0
var odo_sin_b = 0
var odo_dx_01mm = 0
var odo_dy_01mm = 0

# Ativar apenas o timer (não iniciar motores)
var odo_ticks = 0

var odo_snapshot[6] = [0, 0, 0, 0, 0, 0]


# Buffer para 40 ciclos de 100 ms
var odo_record_n = 0
var odo_dl_log[40]
var odo_dr_log[40]
var odo_pose_log[3] = [0, 0, 0]

# V2: coordenadas em unidades de 0,01 mm
var odo_x_coarse = 0
var odo_x_rem = 0
var odo_x_carry = 0
var odo_y_coarse = 0
var odo_y_rem = 0
var odo_y_carry = 0
var odo_ds2_005mm = 0
var odo_dx_001mm = 0
var odo_dy_001mm = 0
var odo_pose_hi_log[4] = [0, 0, 0, 0]

var odo_half_b = 0
var odo_turns = 0


# Controlador linear V3.4
var lin_request = 0
var lin_mode = 0
var lin_active_mode = 0
var lin_abort = 0
var lin_state = 0
var lin_ticks = 0
var lin_progress_001mm = 0
var lin_increment_001mm = 0
var lin_stop_001mm = 0
var lin_settle_ticks = 0
var lin_heading_b = 0
var lin_correction = 0


# V3.6 - Sequencia de simulacao
var seq_request = 0
var seq_abort = 0
var seq_state = 0
var seq_total_ticks = 0
var seq_line_ticks = 0
var seq_turn_ticks = 0
var seq_progress = 0
var seq_angle = 0
var seq_global_angle = 0
var seq_stop_distance = 0
var seq_stop_angle = 0
var seq_wait = 0
var seq_virtual_left = 0
var seq_virtual_right = 0
var seq_history[5]
var seq_history_n = 0
var seq_last_logged = 0

timer.period[0] = 100

onevent timer0
    odo_ticks = odo_ticks + 1
    # Kd [cm/s/unidade] -> deslocamento em 0.1 mm num intervalo de 0.1 s
    # d_01mm = speed * Kd * 10 = speed * KD_MILLI / 100
    call math.muldiv(odo_dl_01mm, motor.left.speed, odo_kd_milli, 100)
    call math.muldiv(odo_dr_01mm, motor.right.speed, odo_kd_milli, 100)

    odo_ds_01mm = (odo_dl_01mm + odo_dr_01mm) / 2
    odo_ds2_005mm = odo_dl_01mm + odo_dr_01mm
    odo_diff_01mm = odo_dr_01mm - odo_dl_01mm

    # distância entre rodas L=9.35 cm = 935 unidades de 0.1mm
    # 1 rad = aprox. 10430 unidades Aseba
    call math.muldiv(odo_dtheta_b, odo_diff_01mm, 10430, 935)

    odo_half_b = odo_dtheta_b / 2

    if odo_half_b > 0 then
        if odo_theta_b > 32767 - odo_half_b then
            odo_theta_mid_b = odo_theta_b - 16384
            odo_theta_mid_b = odo_theta_mid_b - 16384
            odo_theta_mid_b = odo_theta_mid_b + odo_half_b
            odo_theta_mid_b = odo_theta_mid_b - 16384
            odo_theta_mid_b = odo_theta_mid_b - 16384
        else
            odo_theta_mid_b = odo_theta_b + odo_half_b
        end
    else
        if odo_theta_b < -32768 - odo_half_b then
            odo_theta_mid_b = odo_theta_b + 16384
            odo_theta_mid_b = odo_theta_mid_b + 16384
            odo_theta_mid_b = odo_theta_mid_b + odo_half_b
            odo_theta_mid_b = odo_theta_mid_b + 16384
            odo_theta_mid_b = odo_theta_mid_b + 16384
        else
            odo_theta_mid_b = odo_theta_b + odo_half_b
        end
    end
    call math.cos(odo_cos_b, odo_theta_mid_b)
    call math.sin(odo_sin_b, odo_theta_mid_b)

    # cos/sin Aseba escalados aproximadamente por 32767
    call math.muldiv(odo_dx_001mm, odo_ds2_005mm, odo_cos_b, 6553)
    call math.muldiv(odo_dy_001mm, odo_ds2_005mm, odo_sin_b, 6553)

    odo_x_rem = odo_x_rem + odo_dx_001mm
    odo_x_carry = odo_x_rem / 10
    odo_x_coarse = odo_x_coarse + odo_x_carry
    odo_x_rem = odo_x_rem - odo_x_carry * 10
    odo_x_01mm = odo_x_coarse
    odo_y_rem = odo_y_rem + odo_dy_001mm
    odo_y_carry = odo_y_rem / 10
    odo_y_coarse = odo_y_coarse + odo_y_carry
    odo_y_rem = odo_y_rem - odo_y_carry * 10
    odo_y_01mm = odo_y_coarse
    if odo_dtheta_b > 0 then
        if odo_theta_b > 32767 - odo_dtheta_b then
            odo_theta_b = odo_theta_b - 16384
            odo_theta_b = odo_theta_b - 16384
            odo_theta_b = odo_theta_b + odo_dtheta_b
            odo_theta_b = odo_theta_b - 16384
            odo_theta_b = odo_theta_b - 16384
            odo_turns = odo_turns + 1
        else
            odo_theta_b = odo_theta_b + odo_dtheta_b
        end
    else
        if odo_theta_b < -32768 - odo_dtheta_b then
            odo_theta_b = odo_theta_b + 16384
            odo_theta_b = odo_theta_b + 16384
            odo_theta_b = odo_theta_b + odo_dtheta_b
            odo_theta_b = odo_theta_b + 16384
            odo_theta_b = odo_theta_b + 16384
            odo_turns = odo_turns - 1
        else
            odo_theta_b = odo_theta_b + odo_dtheta_b
        end
    end

    # Registar os incrementos efetivamente usados no cálculo
    if odo_record_n < 40 then
        odo_dl_log[odo_record_n] = odo_dl_01mm
        odo_dr_log[odo_record_n] = odo_dr_01mm
        odo_pose_log = [odo_x_01mm, odo_y_01mm, odo_theta_b]
        odo_pose_hi_log = [
            odo_x_coarse, odo_x_rem,
            odo_y_coarse, odo_y_rem
        ]
        odo_record_n = odo_record_n + 1
    end


    # Fotografia da pose e das velocidades após cada ciclo
    odo_snapshot = [
        odo_ticks,
        odo_x_01mm,
        odo_y_01mm,
        odo_theta_b,
        motor.left.speed,
        motor.right.speed
    ]


# V3.6 - Maquina de estados, apenas simulacao
# Nenhum comando de movimento diferente de zero.

motor.left.target = 0
motor.right.target = 0

if seq_abort == 1 then
    seq_state = 6
end

if seq_state == 0 then
    if seq_request == 1 then
        seq_request = 0
        seq_total_ticks = 0
        seq_line_ticks = 0
        seq_turn_ticks = 0
        seq_progress = 0
        seq_angle = 0
        seq_global_angle = 0
        seq_stop_distance = 0
        seq_stop_angle = 0
        seq_wait = 0
        seq_history_n = 0
        seq_last_logged = 0
        seq_state = 1
    end

elseif seq_state == 1 then
    # Simular avancar 0,25 cm a cada ciclo.
    seq_total_ticks = seq_total_ticks + 1
    seq_line_ticks = seq_line_ticks + 1
    seq_progress = seq_progress + 250

    if seq_progress >= 7000 then
        seq_virtual_left = 40
        seq_virtual_right = 40
    else
        seq_virtual_left = 80
        seq_virtual_right = 80
    end

    if seq_line_ticks >= 60 then
        seq_state = 6
    elseif seq_progress >= 9700 then
        seq_stop_distance = seq_progress
        seq_wait = 0
        seq_state = 2
    end

elseif seq_state == 2 then
    seq_total_ticks = seq_total_ticks + 1
    seq_wait = seq_wait + 1
    seq_virtual_left = 0
    seq_virtual_right = 0

    if seq_wait >= 5 then
        seq_wait = 0
        seq_angle = 0
        seq_state = 3
    end

elseif seq_state == 3 then
    # Simular incremento de 2,8125 graus por ciclo.
    seq_total_ticks = seq_total_ticks + 1
    seq_turn_ticks = seq_turn_ticks + 1
    seq_angle = seq_angle + 512
    seq_global_angle = seq_global_angle + 512

    if seq_angle >= 11833 then
        seq_virtual_left = -30
        seq_virtual_right = 30
    else
        seq_virtual_left = -60
        seq_virtual_right = 60
    end

    if seq_turn_ticks >= 95 then
        seq_state = 6
    elseif seq_angle >= 16111 then
        seq_stop_angle = seq_angle
        seq_wait = 0
        seq_state = 4
    end

elseif seq_state == 4 then
    seq_total_ticks = seq_total_ticks + 1
    seq_wait = seq_wait + 1
    seq_virtual_left = 0
    seq_virtual_right = 0

    if seq_wait >= 5 then
        seq_state = 5
    end
end

if seq_total_ticks >= 150 then
    if seq_state != 5 then
        seq_state = 6
    end
end

if seq_state == 5 or seq_state == 6 then
    seq_virtual_left = 0
    seq_virtual_right = 0
end

# Registar transicoes uma unica vez.
if seq_state != seq_last_logged then
    if seq_history_n < 5 then
        seq_history[seq_history_n] = seq_state
        seq_history_n = seq_history_n + 1
    end
    seq_last_logged = seq_state
end
